  m_Script: {fileID: 11500000, guid: d30390f7d1302fe41a656cadb514fd99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectableObject
  message: "\uB0A1\uC740 \uD559\uAD50 \uC0DD\uD65C \uC218\uCE59\uC774\uB2E4.\r\n\r\n1.
    \uC218\uC5C5 \uC2DC\uC791 \uC804\uAE4C\uC9C0 \uC9C0\uC815\uB41C \uC88C\uC11D\uC5D0
    \uCC29\uC11D\uD560 \uAC83.\r\n2. \uAD50\uB0B4\uC5D0\uC11C\uB294 \uB6F0\uC9C0
    \uB9D0 \uAC83.\r\n3. \uBC29\uACFC \uD6C4\uC5D0\uB294 \uD5C8\uAC00 \uC5C6\uC774
    \uAD50\uC2E4\uC5D0 \uB0A8\uC9C0 \uB9D0 \uAC83.\r\n4. \uC18C\uB4F1 \uC774\uD6C4\uC5D0\uB294
    \uBCF5\uB3C4\uB97C \uB3CC\uC544\uB2E4\uB2C8\uC9C0 \uB9D0 \uAC83.\r\n5. \uC57C\uAC04\uC5D0
    \uB204\uAD70\uAC00 \uC774\uB984\uC744 \uBD88\uB7EC\uB3C4 \uC808\uB300 \uB300\uB2F5\uD558\uC9C0
    \uB9D0 \uAC83."
  useHorrorText: 0
